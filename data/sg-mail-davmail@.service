# SG Mail: DavMail, the gateway to one Microsoft account's calendars and
# contacts (CalDAV/CardDAV on 127.0.0.1 only), for SG Mail's Thunderbird.
# Set up, started and removed by SG Mail (/usr/lib/sg-mail/sg-mail-davmail);
# it is not enabled at login: SG Mail starts it when it starts.
[Unit]
Description=SG Mail calendar and contacts gateway (DavMail) for %i
Documentation=man:systemd.service(5) https://davmail.sourceforge.net/
ConditionPathExists=%E/sg-mail/davmail/%i/davmail.properties
# started again whenever it ends, but not in a tight loop
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=exec
ExecStart=/usr/lib/sg-mail/sg-mail-davmail run %i
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=yes
MemoryHigh=1200M
