# SG Mail's test IMAP server: Dovecot, run unprivileged by the gate in a
# scratch directory (@DIR@), plain IMAP on 127.0.0.1:@PORT@ and IMAPS on
# @SPORT@ (a scratch CA's certificate). Users and passwords: @DIR@/users.
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0
protocols = @PROTOCOLS@
listen = 127.0.0.1
base_dir = @DIR@/run
state_dir = @DIR@/state
log_path = @DIR@/dovecot.log
info_log_path = @DIR@/dovecot.log
default_internal_user = @USER@
default_internal_group = @GROUP@
default_login_user = @USER@
auth_allow_cleartext = yes
auth_mechanisms = plain login
ssl = yes
ssl_server_cert_file = @DIR@/server.crt
ssl_server_key_file = @DIR@/server.key
@DEBUG@

passdb passwd-file {
  default_password_scheme = PLAIN
  passwd_file_path = @DIR@/users
}
userdb static {
  fields {
    uid = @UID@
    gid = @GID@
    home = @DIR@/mail/%{user | username}
  }
}
mail_driver = maildir
mail_path = ~/Maildir
mail_uid = @UID@
mail_gid = @GID@
first_valid_uid = 1
imap_idle_notify_interval = 2s
mailbox_idle_check_interval = 1s

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }
}

service imap-login {
  chroot =
  user = @USER@
  inet_listener imap {
    port = @PORT@
  }
  inet_listener imaps {
    port = @SPORT@
    ssl = yes
  }
}
service imap {
  user = @USER@
}
service auth {
  user = @USER@
  unix_listener auth-userdb {
    user = @USER@
  }
}
service auth-worker {
  user = @USER@
}
service anvil {
  chroot =
  user = @USER@
}
service log {
  user = @USER@
}
service stats {
  user = @USER@
}
service config {
  user = @USER@
}
@SIEVE@
